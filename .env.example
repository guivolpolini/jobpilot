# Ambiente
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_V1_PREFIX=/api/v1
PROJECT_NAME="JobPilot"

# Banco de Dados (PostgreSQL)
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_secret
POSTGRES_DB=jobpilot_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_secret@localhost:5432/jobpilot_db
DATABASE_SYNC_URL=postgresql://jobpilot:jobpilot_secret@localhost:5432/jobpilot_db

# Fila & Cache (Redis & Celery)
REDIS_HOST=localhost
REDIS_PORT=6379
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# LLM Fallback (FreeLLMAPI ou OpenAI)
# FreeLLMAPI local roda em http://localhost:3001/v1 (compatível com OpenAI)
OPENAI_BASE_URL=http://localhost:3001/v1
OPENAI_API_KEY=dummy-local-key
LLM_MODEL=auto

# Storage (local vs S3 / MinIO)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./uploads
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=jobpilot-resumes
S3_REGION=us-east-1

# Google Sheets
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEET_NAME=JobPilot_Vagas
